MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=eti_leitura
# Gere um segredo com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local by default; use s3 on free hosting so uploads survive restarts.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Password recovery: optional SMTP, manual administrator links work without it.
PUBLIC_APP_URL=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional teacher AI. Server-only: never use a REACT_APP_ prefix for this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Maximum attempts per educator per UTC day (failed attempts also count).
AI_DAILY_LIMIT=20

# Web Push. Generate once with scripts/setup_push.py; keep the private key server-side.
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Real contact mailto:school@example.com or public HTTPS site URL.
# Falls back to PUBLIC_APP_URL only when it is HTTPS.
VAPID_SUBJECT=
